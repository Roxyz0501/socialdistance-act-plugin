<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>SocialDistance</RootNamespace>
    <AssemblyName>SocialDistance</AssemblyName>
    <Authors>Roxyz0501</Authors>
    <Company>Roxyz0501</Company>
    <Copyright>Copyright © 2026 Roxyz0501</Copyright>
    <ActPath Condition="'$(ActPath)' == ''">C:\Program Files (x86)\Advanced Combat Tracker\Advanced Combat Tracker.exe</ActPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ActPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Jobs\*.png" />
    <EmbeddedResource Include="Assets\Jobs\XIVAPI-LICENSE.txt" />
  </ItemGroup>
</Project>
